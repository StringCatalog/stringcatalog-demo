    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj ting til dine fotos. Bare en lille test."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add items to your photos. Testing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade elementos a tus fotos. Solo estamos haciendo unas pruebas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega elementos a tus fotos. Solo es una prueba, no es magia negra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng mga item sa iyong mga larawan. Pagsusuri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des éléments à vos photos. Juste pour tester, promis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มไอเท็มสุดลับลงในรูปถ่ายของคุณ ทดสอบความเทพกันหน่อย"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想给你的照片加点料？我们需要权限来往你的照片里塞点小物件（测试中）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的照片上加點小道具。測試中，別害羞。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想喺你嘅相片度加啲小道具，所以要申請權限幫你加相。測試中，唔好意思呀。"
          }
        }
      }
    }
  },
  "version" : "1.0"
