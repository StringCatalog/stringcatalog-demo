    "Quickly pick up where you left off or find new shows in Browse." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt hurtigt, hvor du slap, eller find nye serier under Gennemse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly pick up where you left off or find new shows in Browse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge rápidamente donde lo dejaste o encuentra nuevos programas en Navegar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa rápidamente donde lo dejaste o encuentra nuevos programas en Explorar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mabilis na ipagpatuloy kung saan ka tumigil o maghanap ng mga bagong palabas sa Browse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez rapidement là où vous vous étiez arrêté ou trouvez de nouvelles émissions dans Parcourir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단한 위치에서 빠르게 이어 듣거나 둘러보기에서 새로운 프로그램을 찾아보세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยิบขึ้นได้อย่างรวดเร็วจากจุดที่คุณเลิกไปหรือค้นหารายการใหม่ใน Browse"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速从您离开的地方继续或在浏览中找到新节目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速從您停止的地方恢復，或在瀏覽中找到新節目。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速接續你上次的進度或在瀏覽中尋找新節目。"
          }
        }
      }
