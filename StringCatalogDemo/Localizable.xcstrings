    "Quickly pick up where you left off or find new shows in Browse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly pick up where you left off or find new shows in Browse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge rápidamente donde lo dejaste o encuentra nuevos programas en Navegar."
