    "Quickly pick up where you left off or find new shows in Browse." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استأنف بسرعة من حيث توقفت أو اعثر على برامج جديدة في «تصفح»."
          }
        },
        "de" : {
          "stringUnit" : {
