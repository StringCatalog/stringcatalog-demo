    "Quickly pick up where you left off or find new shows in Browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnapp dir direkt, wo du aufgehört hast, oder entdecke neue Shows im Bereich \"Browse\"."
